# /etc/m4ml-web/gateway.env (root:m4ml-web 0640). No secrets here (see LoadCredential).
STUDIO_WEB_HOME=/srv/m4ml-web/data
STUDIO_WEB_FRONTEND=/srv/m4ml-web/app/frontend/dist
STUDIO_WEB_PYTHON=/srv/m4ml-web/runtime/bin/python
STUDIO_WEB_SAM_CHECKPOINT=/srv/m4ml-web/models/sam3.1/sam3.1_multiplex.pt
STUDIO_WEB_MAX_ACTIVE_SESSIONS=3
STUDIO_WEB_SANDBOX=bwrap
STUDIO_WEB_BWRAP=/usr/local/libexec/m4ml-web/bwrap
STUDIO_GPU_LOCK_DIR=/run/m4ml-gpu
STUDIO_WEB_HOSTS=127.0.0.1,localhost
# set to 1 only when the gateway is reached exclusively through the local cloudflared
STUDIO_WEB_TRUST_CLOUDFLARE=0
# operator e-mail shown in the privacy notice (set by install.sh M4ML_CONTACT=...)
# STUDIO_WEB_CONTACT=ops@example.org
